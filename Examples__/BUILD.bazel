cocotb_test_suite(
    name = "o2_rvv_cocotb_test",
    simulators = ["verilator"],
    testcases = ["o2_rvv_add_intrinsic_test"],
    testcases_vname = "PIPELINE_IMG_TESTCASES",
    tests_kwargs = {
        "waves": False,
        "hdl_toplevel": "VmeCoreMiniAxi",
        "seed": "42",
        "test_module": ["o2_rvv_cocotb_test.py"],
        "deps": [
            "//coralnpu_test_utils:sim_test_fixture",
            "@bazel_tools//tools/python/runfiles",
        ],
        "data": [":coralnpu_v2_rvv_add_intrinsic.elf"],
        "size": "large",
        "timeout": "eternal",
    },
    verilator_model = "//tests/cocotb:vme_core_mini_axi_model",
)


